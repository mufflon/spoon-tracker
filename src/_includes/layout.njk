<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="color-scheme" content="dark">
  <meta name="theme-color" content="#141118">
  <title>{{ title or "Spoon collection" }}</title>

  <link rel="stylesheet" href="assets/style.css">

  <link rel="manifest" href="manifest.webmanifest">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="Spoons">
  <link rel="apple-touch-icon" href="assets/icon-180.png">
  <link rel="icon" type="image/png" sizes="192x192" href="assets/icon-192.png">

  <link rel="stylesheet" href="assets/leaflet/leaflet.css">
  <script defer src="assets/leaflet/leaflet.js"></script>
  <script type="module" src="assets/app.js"></script>
</head>
<body>
  <main id="app" data-api="{{ config.apiBase }}">
    {{ content | safe }}
  </main>

  <!-- Service worker: installable app + offline VIEWING (adding needs a connection). -->
  <script>
    if ("serviceWorker" in navigator) {
      window.addEventListener("load", function () {
        navigator.serviceWorker.register("sw.js").catch(function () {});
      });
    }
  </script>
</body>
</html>
